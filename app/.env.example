# Copie a .env y ajuste. Las variables se leen del entorno (use `set -a; . ./.env; set +a` o su orquestador).
DATABASE_URL=postgres://corretaje:CAMBIAR@127.0.0.1:5432/corretaje
JWT_SECRET=        # largo y aleatorio; si se omite se genera y guarda en .jwt_secret
PORT=3000
TRUST_PROXY=0      # 1 solo si hay un proxy inverso de confianza delante (para la IP real en el limitador)
DEMO_PASSWORD=     # contrasena de los usuarios demo al ejecutar db/seed.js
